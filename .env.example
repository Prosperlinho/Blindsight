# BlindSight environment
#
# Copy to .env.local and fill in what you need. Every value below is optional
# for the default NEAR testnet flow. Shared publishing needs Pinata credentials
# and a stable dataset-encryption key; the private Gloam rail needs
# GLOAM_RECEIVE_KEY and GLOAM_NOTE_STORE_KEY. Test ETH for the payer comes from
# https://faucet.testnet.chain.robinhood.com

# ── AI inference (required for real answers) ─────────────────────────────────
NEAR_AI_API_KEY=

# ── NEAR testnet payments ────────────────────────────────────────────────────
# The account that receives query fees. Defaults to the funded BlindSight
# testnet treasury, so a fresh clone works without configuring anything.
# NEXT_PUBLIC_BLINDSIGHT_TREASURY_ACCOUNT=blindsight-ceeaa6612a.testnet
# BLINDSIGHT_TREASURY_ACCOUNT=blindsight-ceeaa6612a.testnet

# ── Shared user-published vaults (Pinata IPFS) ───────────────────────────────
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
# Stable 32-byte hex key; generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PUBLISHED_VAULT_ENCRYPTION_KEY=
# Optional custom IPFS gateway; defaults to https://gateway.pinata.cloud
# PINATA_GATEWAY_URL=

# ── Gloam private payments (Robinhood Chain testnet) ─────────────────────────
#
# Generate the two secrets once with:
#   node scripts/gloam-keygen.mjs
#
# GLOAM_RECEIVE_KEY is the JSON receive identity the server uses to open and
# sweep private payments. Keep it secret and stable: changing it makes older
# payments unreadable.
GLOAM_RECEIVE_KEY=

# 32-byte hex key used to encrypt the on-disk note/receipt store at rest.
GLOAM_NOTE_STORE_KEY=

# Optional paths. The defaults are fine for local development.
# GLOAM_NOTE_STORE_PATH=.gloam-data/notes.enc.json
# GLOAM_CIRCUIT_CACHE_PATH=

# Leave unset (or "false") until the private flow has been verified end to end
# on testnet. When "true", the marketplace shows the optional private payment
# control.
# NEXT_PUBLIC_GLOAM_ENABLED=false
