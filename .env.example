# BlindSight environment
#
# Copy to .env.local and fill in what you need. Every value below is optional
# for the default NEAR testnet flow. Shared publishing needs Supabase access
# and a stable dataset-encryption key.

# ── AI inference (required for real answers) ─────────────────────────────────
NEAR_AI_API_KEY=

# ── NEAR testnet payments ────────────────────────────────────────────────────
# The account that receives query fees. Defaults to the funded BlindSight
# testnet treasury, so a fresh clone works without configuring anything.
# NEXT_PUBLIC_BLINDSIGHT_TREASURY_ACCOUNT=blindsight-ceeaa6612a.testnet
# BLINDSIGHT_TREASURY_ACCOUNT=blindsight-ceeaa6612a.testnet

# ── Platform fees ────────────────────────────────────────────────────────────
# Fees go to the platform treasury (defaults to the treasury account above).
# Query fee is added on top of each vault price; publishing fee is paid once per
# vault. Set a fee to 0 to turn it off. Defaults: 0.01 and 0.05 NEAR.
# NEXT_PUBLIC_BLINDSIGHT_PLATFORM_TREASURY=blindsight-ceeaa6612a.testnet
# NEXT_PUBLIC_BLINDSIGHT_QUERY_FEE_NEAR=0.01
# NEXT_PUBLIC_BLINDSIGHT_PUBLISH_FEE_NEAR=0.05

# ── Shared user-published vaults (Supabase) ──────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Stable 32-byte hex key; generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PUBLISHED_VAULT_ENCRYPTION_KEY=
