# Server-side key for NEAR AI Cloud inference (required for answers).
NEAR_AI_API_KEY=

# Real NEAR testnet treasury that receives each query fee.
# Both values may point at the same account. The public one is exposed to the browser.
BLINDSIGHT_TREASURY_ACCOUNT=blindsight-ceeaa6612a.testnet
NEXT_PUBLIC_BLINDSIGHT_TREASURY_ACCOUNT=blindsight-ceeaa6612a.testnet

# Payment network used by the UI (testnet only in this prototype).
NEXT_PUBLIC_NEAR_NETWORK=testnet
